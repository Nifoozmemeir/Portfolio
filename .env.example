# Lista de variables que necesita el proyecto. 

# Cada máquina tiene su propio .env:
#   - Tu PC usa el bloque LOCAL + AWS (lo lee Base/settingslocal.py)
#   - El server usa el bloque PROD + AWS (lo lee Base/settingsproduction.py)

# ===== LOCAL (tu PC) =====
DB_NAME_LOCAL=nombre_base_local
DB_USER_LOCAL=usuario
DB_PASSWORD_LOCAL=contraseña
DB_HOST_LOCAL=localhost
DB_PORT_LOCAL=5432

# ===== PRODUCCIÓN (server Lightsail) =====
SECRET_KEY_PROD=clave-larga-y-aleatoria
LIGHTSAIL_IP=0.0.0.0
DB_NAME_PROD=nombre_base_produccion
DB_USER_PROD=usuario
DB_PASSWORD_PROD=contraseña
DB_HOST_PROD=localhost
DB_PORT_PROD=5432

# ===== AWS S3 (las dos máquinas, mismo bucket) =====
AWS_ACCESS_KEY_ID=tu-access-key
AWS_SECRET_ACCESS_KEY=tu-secret-key
AWS_STORAGE_BUCKET_NAME=nombre-del-bucket
AWS_S3_REGION_NAME=us-east-1